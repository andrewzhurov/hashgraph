(defn svg-fa [{:keys [size style]} & content]
  (into [:svg.svg-inline--fa {:xmlns   "http://www.w3.org/2000/svg",
                              :viewBox "0 0 48 48"
                              :class   (str "fa-" size)
                              :fill    (:color style)}]
        content))

(defn svg [{:keys [style scale]} & content]
  (into [:svg {:xmlns   "http://www.w3.org/2000/svg",
               :viewBox "0 0 48 48"
               :fill    (:color style)
               :style   {:scale   (or scale 1)}}]
        content))

